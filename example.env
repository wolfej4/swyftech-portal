# SwyfTech client portal settings. The installer writes /opt/swyftech-portal/.env for you.
# After editing, run: systemctl restart swyftech-portal

# Public address clients use. Must be https in production (Stripe and secure cookies need it).
BASE_URL=https://portal.example.com
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=America/Chicago

BUSINESS_NAME=SwyfTech LLC
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=(850) 555-0100
STAFF_NOTIFY_EMAIL=you@example.com
TAGLINE=IT support for businesses across Okaloosa, Santa Rosa, Walton and Escambia counties.

# Invoices
INVOICE_PREFIX=SWY
DEFAULT_NET_DAYS=15
PAYMENT_TERMS_NOTE=Payment is due by the date shown. Thank you for your business.

# Email (Microsoft 365: smtp.office365.com, 587, starttls, with SMTP AUTH enabled on the mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Snipe-IT (optional). Read-only: the portal never changes anything in Snipe-IT.
# Use the internal address; Snipe-IT doesn't need to be public.
SNIPEIT_URL=
SNIPEIT_API_TOKEN=
# Set to false if Snipe-IT uses a self-signed certificate
SNIPEIT_VERIFY_TLS=true
SNIPEIT_CACHE_MINUTES=5
SNIPEIT_WARRANTY_WARN_DAYS=60

# S3-compatible storage for documents and request attachments (optional).
# Leave S3_BUCKET blank to keep files on this container's disk.
# Garage:    S3_ENDPOINT_URL=http://10.0.10.30:3900   S3_REGION=garage
# SeaweedFS: S3_ENDPOINT_URL=http://10.0.10.31:8333   S3_REGION=us-east-1
# B2 / R2 / AWS: use the endpoint and region they give you.
# After setting these: portal-cli check-storage, then portal-cli move-files-to-s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PREFIX=swyftech-portal/
S3_VERIFY_TLS=true

MAX_UPLOAD_MB=25
MAX_FILES_PER_MESSAGE=5
SESSION_HOURS=12
